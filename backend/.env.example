# Application
APP_NAME=FoodStallHub API
API_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=true

# Security
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_REGISTRATION_KEY=change-admin-key
SUPER_ADMIN_REGISTRATION_KEY=change-super-admin-key

# PostgreSQL (users, stalls, menu)
POSTGRES_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/foodstallhub

# MongoDB (orders, reviews, analytics)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=foodstallhub

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]